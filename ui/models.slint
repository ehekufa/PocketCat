// Shared data shapes passed between Rust models and reusable Slint components.
export struct SceneItem { id: string, title: string }
export struct SpriteItem { name: string, x: float, y: float, size: float, rotation: float, alpha: float, tint: color, costume: float, visible: bool }
export struct CategoryItem { title: string, color: color }
export struct BlockItem { id: string, title: string, color: color }
