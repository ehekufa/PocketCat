export component StatusBar inherits Rectangle {
    in property <string> status;
    in property <string> page;
    in property <int> scene-count;
    height: 38px; background: #052933; border-color: #17454f; border-width: 1px;
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; spacing: 9px;
        Rectangle { width: 7px; height: 7px; background: #38c6aa; border-radius: 4px; }
        Text { text: root.status; color: #91b8bd; font-size: 11px; overflow: elide; horizontal-stretch: 1; }
        if root.page == "projects": Text { text: root.scene-count + " сцен"; color: #628f97; font-size: 10px; }
    }
}
